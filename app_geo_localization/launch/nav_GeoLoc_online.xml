<launch>

  <!-- start  -->
  <include file="$(find-pkg-share robot_blue)/launch/start_nav_nodes.launch" />
  
  <!-- Fusion-based localization by optimization process -->
  <node pkg="geo_localization" exec="geo_localization" name="geo_localization" output="screen">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_online/geo_localization.yaml"/>
  </node>

  <!-- GPS observations in odometry format -->
  <node pkg="gps_to_odom" exec="gps_to_odom" name="gps_to_odom" output="screen">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_online/gps_to_odom.yaml"/>
  </node>
  
  <!-- lidar odometry -->
 <!-- <node pkg="pc2image" exec="pc2image" name="pc2image_node">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_offline.yaml"/>
  </node> -->
  <node pkg="odom_estimation_pc" exec="odom_estimation_node" name="odom_estimation_node">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_offline.yaml"/>
  </node>   

  <!-- Nodes to ground lines detection -->
  <node pkg="merged_channels_ouster" name="merge_channels" exec="merge_channels_ouster.py"></node>
  <node pkg="image2pcl"   exec="image2pcl_node" name="image2pcl" output="screen">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_online/image2pcl.yaml"/>
  </node>

  <node exec="rviz2" name="rviz2" pkg="rviz2" args="-d $(find-pkg-share app_geo_localization)/rviz/nav_geoloc.rviz" >
  </node>
  
</launch>
