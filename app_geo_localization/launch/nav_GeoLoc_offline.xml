<launch>

  <!-- rosbags list -->
  <arg name="bag_file_1" default="/home/alolivas/aurova-lab/labrobotica/dataset/rosbag/ros2/2023-06-13-08-44-15"/>
  <arg name="silence" default="--ros-args --disable-stdout-logs"/>

  <!-- select your robot -->
  <include file="$(find-pkg-share robot_blue)/launch/components/start_tf.launch.xml" />
  
  <!-- Fusion-based localization by optimization process -->
  <node pkg="geo_localization" exec="geo_localization" name="geo_localization" output="screen">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_offline.yaml"/>
  </node>

  <!-- GPS observations in odometry format -->
  <node pkg="gps_to_odom" exec="gps_to_odom" name="gps_to_odom" output="screen">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_offline.yaml"/>
  </node>
  
  <!-- lidar odometry -->
  <node pkg="pc2image" exec="pc2image" name="pc2image">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_offline.yaml"/>
  </node>

  <node pkg="odom_estimation_pc" exec="odom_estimation_node" name="odom_estimation_pc" output="screen">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_offline.yaml"/>
  </node>

  <!-- Nodes to ground lines detection -->
  <node pkg="merge_channels_ouster" name="merge_channels" exec="merge_channels_ouster">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_offline.yaml"/>
  </node>

  <node pkg="image2pcl"   exec="image2pcl_node" name="image2pcl" output="screen">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_offline.yaml"/>
  </node>

  <executable cmd="ros2 bag play $(var bag_file_1) --clock" output="screen" />

  <node exec="rviz2" name="rviz2" pkg="rviz2" args="-d $(find-pkg-share app_geo_localization)/rviz/nav_geoloc.rviz">
    <param from="$(find-pkg-share app_geo_localization)/params/nav_GeoLoc_offline.yaml"/>
  </node>
  
</launch>
